# Python/cache artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environments and notebooks
.venv/
venv/
environment/porespy_smoke_venv/
environment/open_pnm_tools/
.ipynb_checkpoints/
~$*

# Large or local-only raw inputs
*.raw
*.bin
*.h5
*.tif
*.tiff
data/open_datasets/**/*.zip
data/open_datasets/**/*.nc
data/open_datasets/**/*.pdf
*.ilp
*.dwg
*.dxf
*.bak
Thumbs.db
%SystemDrive%/

# Local vendor build artifacts and archives
code/vendor/**/build/local/
code/vendor/**/bin.7z
code/vendor/**/*.exe
code/vendor/**/*.dll
code/vendor/**/*.lib
code/vendor/**/*.obj
code/vendor/**/*.pdf

# Local literature/reference PDFs and downloaded manuscript files
docs/references/*.pdf
docs/references/*.docx
docs/references/**/*.pdf
docs/references/**/*.docx
docs/literature_review/**/*.pdf
docs/literature_review/**/papers/**/*.pdf
docs/validation/*.pdf
docs/validation/*.docx
docs/validation/**/*.pdf
docs/validation/**/*.docx

# Local data inventories and regenerated outputs
data_inventory/
outputs/
results/
tmp/
temp/
scratch/
*.log
*.tmp
*.temp
/data/dissolution_results*/

# Local scratch notebooks
临时*.ipynb
/临时*.md
/figures/

# Standalone pnextract source and runtime are versioned; caches stay local.
/pnextract/**/__pycache__/
/pnextract/**/build/

# Version project inputs under data/, including large files managed by Git LFS.
!/data/
!/data/**

# Reproducible dynamic-process outputs stay local.
/data/dissolution_results*/

# Office lock files are never source data.
~$*
